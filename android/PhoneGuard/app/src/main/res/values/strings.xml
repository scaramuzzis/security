    <!-- Verifica intercettazione -->
    <string name="interception_loading">Analisi in corso…</string>
    <string name="interception_intro">Combina tutti i segnali già raccolti dall\'app (app spia, controllo remoto, rete cellulare e Wi-Fi) in un unico verdetto, più le verifiche ufficiali sulla deviazione delle chiamate.</string>
    <string name="interception_critical">Rilevata una minaccia critica: probabile app spia attiva</string>
    <string name="interception_warning">Alcuni segnali da verificare con attenzione</string>
    <string name="interception_safe">Nessun segnale di controllo o intercettazione rilevato</string>
    <string name="interception_ussd_title">Verifica deviazione chiamate</string>
    <string name="interception_ussd_intro">Questi codici interrogano direttamente la rete del tuo operatore: è lui a risponderti, non una stima dell\'app. Il tasto apre il tastierino già compilato: tocca la chiamata per confermare.</string>
    <string name="interception_ussd_forward_all">Controlla se le chiamate sono deviate (*#21#)</string>
    <string name="interception_ussd_forward_busy">Controlla deviazione se occupato (*#67#)</string>
    <string name="interception_ussd_forward_unreachable">Controlla deviazione se irraggiungibile (*#62#)</string>
    <string name="interception_ussd_disable_all">Disattiva tutte le deviazioni (##002#)</string>
    <string name="interception_ussd_imei">Mostra il codice IMEI (*#06#)</string>
    <string name="interception_disclaimer">Limite onesto: nessuna app, PhoneGuard incluso, può rilevare con certezza assoluta un\'intercettazione a livello di rete o di un\'autorità (es. IMSI-catcher, intercettazione dell\'operatore). Questi sono indizi concreti raccolti con le API disponibili a un\'app senza privilegi di sistema, non una prova definitiva.</string>

