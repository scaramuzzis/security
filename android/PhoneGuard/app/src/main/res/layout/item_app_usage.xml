<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:id="@+id/appDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:id="@+id/appHiddenBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hidden_app_badge"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/status_warn"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/warningIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@string/suspicious_app"
        android:src="@drawable/ic_warning"
        android:visibility="gone"
        app:tint="@color/warning" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/appStopButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/stop_app"
        android:visibility="gone" />

</LinearLayout>
