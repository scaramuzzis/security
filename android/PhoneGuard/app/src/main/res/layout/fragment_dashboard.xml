<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header di stato: il "semaforo" del telefono -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/statusIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_icon_unknown"
                    android:textSize="52sp" />

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/status_unknown"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/statusDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/status_unknown_detail"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/cyber_on_surface_dim" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick action principale -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/globalScanButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/global_scan" />

        <!-- Barra di avanzamento dell'Analisi Globale (4 fasi) -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/scanProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="5"
            android:visibility="gone" />

        <TextView
            android:id="@+id/scanProgressLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/cyber_on_surface_dim"
            android:visibility="gone" />

        <!-- Ottimizza il cellulare: ferma le app non di sistema attive in background -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/optimizeButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/optimize_phone" />

        <TextView
            android:id="@+id/optimizeResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/cyber_on_surface_dim"
            android:visibility="gone" />

        <!-- Anelli di stato: batteria, RAM, archiviazione -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/device_status"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    app:drawableStartCompat="@drawable/ic_dashboard" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/RingColumn">
                        <com.cybersentinel.phoneguard.ui.chart.RingGaugeView
                            android:id="@+id/ringBattery"
                            android:layout_width="72dp"
                            android:layout_height="72dp" />
                        <TextView style="@style/RingCaption" android:text="@string/ring_battery"
                            app:drawableTopCompat="@drawable/ic_battery" />
                    </LinearLayout>

                    <LinearLayout style="@style/RingColumn">
                        <com.cybersentinel.phoneguard.ui.chart.RingGaugeView
                            android:id="@+id/ringRam"
                            android:layout_width="72dp"
                            android:layout_height="72dp" />
                        <TextView style="@style/RingCaption" android:text="@string/ring_ram"
                            app:drawableTopCompat="@drawable/ic_memory" />
                    </LinearLayout>

                    <LinearLayout style="@style/RingColumn">
                        <com.cybersentinel.phoneguard.ui.chart.RingGaugeView
                            android:id="@+id/ringStorage"
                            android:layout_width="72dp"
                            android:layout_height="72dp" />
                        <TextView style="@style/RingCaption" android:text="@string/ring_storage"
                            app:drawableTopCompat="@drawable/ic_storage" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Donut: ripartizione della sicurezza (dopo l'Analisi Globale) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/securityChartCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.cybersentinel.phoneguard.ui.chart.DonutChartView
                    android:id="@+id/securityDonut"
                    android:layout_width="120dp"
                    android:layout_height="120dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_breakdown"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <TextView android:id="@+id/legendOk" style="@style/Legend"
                        app:drawableStartCompat="@drawable/dot" />
                    <TextView android:id="@+id/legendWarn" style="@style/Legend"
                        app:drawableStartCompat="@drawable/dot" />
                    <TextView android:id="@+id/legendDanger" style="@style/Legend"
                        app:drawableStartCompat="@drawable/dot" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Contatori -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/counterThreats"
                layout="@layout/view_counter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/counterChecks"
                layout="@layout/view_counter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/counterFiles"
                layout="@layout/view_counter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/counterEnergy"
                layout="@layout/view_counter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Batteria in tempo reale -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/batteryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/battery_loading"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Referto dell'analista on-device -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/analystCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/analystHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/analystSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/analystRecommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/analyst_disclaimer"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/cyber_on_surface_dim" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Consumo di PhoneGuard in tempo reale -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/selfUsageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/self_usage_loading"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Controlli attivi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/active_controls"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMonitoring"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/toggle_monitoring" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBatteryAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/toggle_battery_alerts" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchFileScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/toggle_file_scan" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAppStartAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/toggle_app_start_alerts" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
